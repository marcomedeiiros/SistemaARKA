# Porta em que a API sobe
PORT=4000

# Caminho do arquivo SQLite (relativo à pasta server/)
DATABASE_FILE=data/arka.db

# Origens permitidas no CORS, separadas por vírgula
CORS_ORIGIN=http://localhost:5173,http://localhost:4173

# Popula o banco com os dados de demonstração quando ele estiver vazio
SEED_ON_EMPTY=true
